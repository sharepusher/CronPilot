[default]
# 复制为 conf.ini 后修改
is_single=1
is_dev=0
redis_host=127.0.0.1
redis_port=6379
redis_pwd=
redis_db=0
cron_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_scheduler
cron_job_log_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_job_log
login_pwd=请改为强密码或使用 scripts/hash_login_password.py 生成 pbkdf2 哈希
# 会话签名密钥（勿写入本文件）：生产必须设置环境变量 SECRET_KEY（长度≥16，且非源码默认值）
#   export SECRET_KEY="$(python -c 'import secrets; print(secrets.token_hex(32))')"
#   或由 scripts/run_production.sh 首次自动写入 datas/.flask_secret_key（多节点须共用同一 SECRET_KEY）
# login_pwd 用途（v1.0+）：
#   - 仅当 rbac_users 为空时，作为自动种子用户 admin 的初始密码（明文或 pbkdf2 均可）
#   - 表中已有用户后，改本项并重启不会更新任何账号密码
# 日常改密：admin 登录 → 用户管理 → 编辑用户 → 「新密码」（留空则不改）
# Web 登录须填用户名+密码；三角色分权始终启用（无旁路开关）；种子角色为 admin
job_log_counts=1000
# 连续失败达到 N 次时任务标为 failing（OPT-P2-13）；默认 3。偶发 1～2 次失败不进异常榜
health_failing_threshold=3
# 管理操作审计保留条数（OPT-P1-09）；0=不裁剪；内置任务每 8 小时按 id 删最旧
operation_log_counts=5000
api_access_token=
# 为空时 /api/* 不做 token 校验（放行所有请求）；生产环境务必配置非空 token。
# api_access_token 是部署级单一密钥，无法按业务组区分调用方，Web 端 Resource Scope
# 隔离在 API 层不生效（已知缺口，见 doc/资源隔离与Scope设计.html §七）。
# api_access_token_required=1 时：若 api_access_token 为空，生产环境启动将 fail-fast
# （run_production.sh / verify_docker_compose.sh 预检 + ProductionConfig.init_app 双重校验）。
# 默认 0（未设置同等于 0），开启前请确保已给所有 API 调用方配置好 token，避免误锁生产。
api_access_token_required=0
api_key=
error_keyword=fail,error
fail_on_http_4xx_5xx=1
error_web_hook=
qywechat_corpid=
qywechat_corpsecret=
qywechat_agentid=
dingding_webhook=
dingding_secret=

# P0 SSRF 防护（可选，默认 block_private_ip=1）
block_private_ip=1
url_allow_hosts=
url_ssrf_observe_only=0

# 结构化日志（可选；默认 JSON 输出，适合 ELK / Loki 接入）
# log_level=INFO
# log_json_enabled=1

# ====== 调度器性能调参（OPT-P1-12）======
# 环境变量 CRONPILOT_SCHEDULER_ENABLED=false 可关闭调度器（Web-only 模式）
# 用途：水平扩容 Web 进程时，仅主进程运行调度器
#
# 当前默认（config.py）：
#   SCHEDULER_EXECUTORS.max_workers = 30  （并发执行任务的线程数上限）
#   SCHEDULER_JOB_DEFAULTS.max_instances = 20 （单任务最大排队实例数）
#   SCHEDULER_JOB_DEFAULTS.misfire_grace_time = 50 （错过触发的宽限秒数）
#
# 调参指南：
#   - 200 个秒级任务 + 平均响应 1s → max_workers=30 足够（稳态 ~5 活跃线程）
#   - 200 个秒级任务 + 目标服务慢(5s) → 稳态 ~25 线程，接近上限，建议调至 50
#   - 500+ 秒级任务 → 建议双进程分离（CRONPILOT_SCHEDULER_ENABLED=false for web）
#   - 监控指标：Prometheus cronpilot_jobs_active > 0.8 * max_workers 持续 5min → 预警

# Prometheus /metrics 端点 Bearer Token（可选）
# 留空时仅允许已登录 Web 用户访问；填写后 Prometheus server 可用 bearer_token 无会话抓取
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
# metrics_token=
