[default]
# 本地 SQLite 试用（复制为 conf.ini：cp conf.local.sqlite.example conf.ini）
# 路径请改为本机仓库绝对路径下的 datas/*.sqlite
is_single=1
is_dev=0
redis_host=127.0.0.1
redis_port=6379
redis_pwd=
redis_db=0
cron_db_url=sqlite:////ABSOLUTE_PATH_TO_REPO/datas/cron.sqlite
cron_job_log_db_url=sqlite:////ABSOLUTE_PATH_TO_REPO/datas/job_log.sqlite
login_pwd=changeme
job_log_counts=1000
api_access_token=
api_key=
error_keyword=fail,error
fail_on_http_4xx_5xx=1
error_web_hook=
qywechat_corpid=
qywechat_corpsecret=
qywechat_agentid=
dingding_webhook=
dingding_secret=
block_private_ip=1
url_allow_hosts=
url_ssrf_observe_only=0
