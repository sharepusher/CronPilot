# 验证 Ubuntu 安装流程（含 venv + --sqlite + gunicorn）
# 构建: docker build -f scripts/docker/Dockerfile.ubuntu -t cronpilot-verify-ubuntu .
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/cronpilot

RUN apt-get update -qq && apt-get install -y -qq curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY . .
RUN useradd -m -s /bin/bash cronpilot && chown -R cronpilot:cronpilot /opt/cronpilot \
  && apt-get update -qq && apt-get install -y -qq sudo software-properties-common \
  && add-apt-repository -y ppa:deadsnakes/ppa \
  && apt-get update -qq && apt-get install -y -qq python3.9 python3.9-venv python3.9-dev \
  && echo 'root ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/docker-root \
  && chmod 440 /etc/sudoers.d/docker-root \
  && rm -rf /var/lib/apt/lists/*

# gevent 23.9 + greenlet 3.1.1：py3.9+ 有预编译 wheel；生产环境推荐 3.9/3.10/3.11
ENV PY=python3.9
RUN SUDO_USER=cronpilot bash scripts/install_ubuntu.sh --production --sqlite

USER cronpilot
RUN bash scripts/verify_linux_install.sh && bash scripts/verify_install_flow.sh

# 生产启动与健康检查（单 worker 避免 SQLite 双进程建表冲突）
RUN bash -euc 'source scripts/lib/python.sh && cronpilot_load_runtime; \
    export FLASK_CONFIG=production; mkdir -p datas/logs; \
    "$CRONPILOT_VENV/bin/gunicorn" -b 0.0.0.0:5860 -w 1 -k gevent -c gun.py manage:app & pid=$!; \
    sleep 8; \
    curl -sf http://127.0.0.1:5860/docs/ | head -c 200 | grep -qi html; \
    code=$(curl -sf -o /dev/null -w "%{http_code}" http://127.0.0.1:5860/); \
    echo "HTTP / => $code"; echo "$code" | grep -qE "200|302"; \
    kill $pid; wait $pid 2>/dev/null || true'
