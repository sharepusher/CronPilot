[default]
# 复制为 conf.ini 后修改
is_single=1
is_dev=0
redis_host=127.0.0.1
redis_port=6379
redis_pwd=
redis_db=0
cron_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_scheduler
cron_job_log_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_job_log
login_pwd=请改为强密码或使用 scripts/hash_login_password.py 生成 pbkdf2 哈希
# 会话签名密钥（勿写入本文件）：生产必须设置环境变量 SECRET_KEY（长度≥16，且非源码默认值）
#   export SECRET_KEY="$(python -c 'import secrets; print(secrets.token_hex(32))')"
#   或由 scripts/run_production.sh 首次自动写入 datas/.flask_secret_key（多节点须共用同一 SECRET_KEY）
# login_pwd 用途（v1.0+）：
#   - 仅当 rbac_users 为空时，作为自动种子用户 admin 的初始密码（明文或 pbkdf2 均可）
#   - 表中已有用户后，改本项并重启不会更新任何账号密码
# 日常改密：admin 登录 → 用户管理 → 编辑用户 → 「新密码」（留空则不改）
# Web 登录须填用户名+密码；三角色分权始终启用（无旁路开关）；种子角色为 admin
job_log_counts=1000
# 连续失败达到 N 次时任务标为 failing（OPT-P2-13）；默认 3。偶发 1～2 次失败不进异常榜
health_failing_threshold=3
# 管理操作审计保留条数（OPT-P1-09）；0=不裁剪；内置任务每 8 小时按 id 删最旧
operation_log_counts=5000
api_access_token=
api_key=
error_keyword=fail,error
fail_on_http_4xx_5xx=1
error_web_hook=
qywechat_corpid=
qywechat_corpsecret=
qywechat_agentid=
dingding_webhook=
dingding_secret=

# P0 SSRF 防护（可选，默认 block_private_ip=1）
block_private_ip=1
url_allow_hosts=
url_ssrf_observe_only=0

# 结构化日志（可选；默认 JSON 输出，适合 ELK / Loki 接入）
# log_level=INFO
# log_json_enabled=1
