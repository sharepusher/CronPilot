[Unit]
Description=CronPilot HTTP scheduler admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cronpilot/CronPilot
Environment=FLASK_CONFIG=production
# 生产必须设置强 SECRET_KEY（或先跑 scripts/run_production.sh 生成 datas/.flask_secret_key 后在此注入同一值）
# Environment=SECRET_KEY=请替换为 secrets.token_hex(32) 的输出
# 按实际 venv 目录修改，如 .venv-py311
ExecStart=/opt/cronpilot/CronPilot/.venv-py311/bin/gunicorn -c gun.py manage:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
