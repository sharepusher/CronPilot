#           ) > 10
#         for: 5m
#         labels:
#           severity: warning
#         annotations:
#           summary: "调度延迟 P95 超过 10 s（可能 gevent worker 过载）"
#
#       - alert: CronActiveJobsZero
#         expr: cronpilot_jobs_active{state="active"} == 0
#         for: 15m
