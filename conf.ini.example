[default]
# 复制为 conf.ini 后修改
is_single=1
is_dev=0
redis_host=127.0.0.1
redis_port=6379
redis_pwd=
redis_db=0
cron_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_scheduler
cron_job_log_db_url=mysql+pymysql://user:pass@127.0.0.1:3306/cron_job_log
login_pwd=请改为强密码或使用 scripts/hash_login_password.py 生成 pbkdf2 哈希
# login_pwd：亦作 rbac_users 空表时自动种子用户 admin 的初始密码；Web 登录须填用户名+密码（不再支持空用户名 / legacy_admin）
job_log_counts=1000
# 管理操作审计保留条数（OPT-P1-09）；0=不裁剪；内置任务每 8 小时按 id 删最旧
operation_log_counts=5000
api_access_token=
api_key=
error_keyword=fail,error
fail_on_http_4xx_5xx=1
error_web_hook=
qywechat_corpid=
qywechat_corpsecret=
qywechat_agentid=
dingding_webhook=
dingding_secret=

# RBAC（OPT-P2-10；修改后须重启进程）
# 0=权限旁路（登录仍须 rbac_users 账号）；1=三角色鉴权。空表时种子 admin（密码=login_pwd）
rbac_enable=0

# P0 SSRF 防护（可选，默认 block_private_ip=1）
block_private_ip=1
url_allow_hosts=
url_ssrf_observe_only=0
