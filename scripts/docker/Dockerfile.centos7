# 验证 CentOS 7 安装流程（SCL rh-python38 + venv）
# 构建: docker build -f scripts/docker/Dockerfile.centos7 -t cronpilot-verify-centos7 .
# 注意: CentOS 7 已 EOL，yum 源指向 vault.centos.org
FROM centos:7
WORKDIR /opt/cronpilot

RUN sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*.repo \
  && sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo

RUN yum install -y -q curl ca-certificates epel-release centos-release-scl \
  && printf '%s\n' \
    '[centos-sclo-rh]' 'name=CentOS-7 - SCLo rh' \
    'baseurl=http://vault.centos.org/centos/7/sclo/$basearch/rh/' \
    'gpgcheck=1' 'enabled=1' \
    'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' \
    > /etc/yum.repos.d/CentOS-SCLo-scl-rh.repo \
  && printf '%s\n' \
    '[centos-sclo-sclo]' 'name=CentOS-7 - SCLo sclo' \
    'baseurl=http://vault.centos.org/centos/7/sclo/$basearch/sclo/' \
    'gpgcheck=1' 'enabled=1' \
    'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' \
    > /etc/yum.repos.d/CentOS-SCLo-scl-sclo.repo \
  && yum clean all

COPY . .
RUN useradd -m -s /bin/bash cronpilot && chown -R cronpilot:cronpilot /opt/cronpilot \
  && yum install -y -q sudo \
  && echo 'root ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/docker-root \
  && chmod 440 /etc/sudoers.d/docker-root \
  && yum clean all

RUN SUDO_USER=cronpilot bash scripts/install_centos.sh --production --sqlite

USER cronpilot
ENV PATH="/opt/rh/rh-python38/root/usr/bin:${PATH}"
RUN bash scripts/verify_linux_install.sh && bash scripts/verify_install_flow.sh

RUN bash -euc 'source scripts/lib/python.sh && cronpilot_load_runtime; \
    export FLASK_CONFIG=production; mkdir -p datas/logs; \
    "$CRONPILOT_VENV/bin/gunicorn" -b 0.0.0.0:5860 -w 1 -k gevent -c gun.py manage:app & pid=$!; \
    sleep 10; curl -sf http://127.0.0.1:5860/docs/ | head -c 200 | grep -qi html; \
    code=$(curl -sf -o /dev/null -w "%{http_code}" http://127.0.0.1:5860/); \
    echo "HTTP / => $code"; echo "$code" | grep -qE "200|302"; \
    kill $pid; wait $pid 2>/dev/null || true'
